# BahriApp v1.1 — configuration template.
#
# Copy to .env and fill in. NEVER commit the filled-in .env.
#   cp .env.example .env
#
# v1.0 hard-coded a plain-HTTP IPv4 address in all 24 endpoints and read
# dashboard credentials from an absolute developer path, so nobody else could
# run the stack. Everything below is what replaced that.

# ---------------------------------------------------------------- client
# Base URL of the ingestion service. MUST be https:// unless you also set
# BAHRI_ALLOW_INSECURE=true (local development only).
BAHRI_API_BASE=https://api.example.org

# SHA-256 pin of the server leaf certificate's public key, base64-encoded.
# Leave empty to rely on the platform trust store instead of pinning.
# Generate with:
#   openssl s_client -connect api.example.org:443 </dev/null 2>/dev/null \
#     | openssl x509 -outform DER | openssl dgst -sha256 -binary | base64
BAHRI_CERT_PIN_SHA256=

# Set true ONLY for a local backend without TLS. Never in a build you ship.
BAHRI_ALLOW_INSECURE=false

# Build the client with these values:
#   flutter build apk --dart-define=BAHRI_API_BASE=$BAHRI_API_BASE \
#                     --dart-define=BAHRI_CERT_PIN_SHA256=$BAHRI_CERT_PIN_SHA256

# ------------------------------------------------------------ admin dashboard
# Path to the Google service-account JSON used by the export path.
# Keep this file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ------------------------------------------------------------------- backend
# Used by deploy/docker-compose.yml for a local stack.
POSTGRES_USER=bahri
POSTGRES_PASSWORD=change-me-before-you-run-anything
POSTGRES_DB=bahri
POSTGRES_PORT=5432

# Secret used by the ingestion service to sign participant session tokens.
# Generate with: openssl rand -hex 32
BAHRI_JWT_SECRET=change-me

# Token lifetimes
BAHRI_ACCESS_TOKEN_TTL=3600
BAHRI_REFRESH_TOKEN_TTL=2592000
